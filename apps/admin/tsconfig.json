{
  "extends": "@didimzip/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "/tmp/didimzip-admin-next/types/**/*.ts",
    "/tmp/didimzip-admin-next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
